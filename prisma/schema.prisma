// Modelo de datos del Sprint 1. Diseño completo y fases siguientes: docs/data-model.md.
// Convenciones: IDs UUIDv7, fechas timestamptz (UTC), dinero en centavos (Int) + moneda.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─────────────────────────────── Identidad ───────────────────────────────
// User, Session, Account, Verification y RateLimit siguen el esquema de Better Auth.

model User {
  id            String   @id @default(uuid(7)) @db.Uuid
  name          String
  email         String   @unique
  emailVerified Boolean  @default(false)
  image         String?
  createdAt     DateTime @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime @updatedAt @db.Timestamptz(3)

  sessions             Session[]
  accounts             Account[]
  profile              Profile?
  sellerProfile        SellerProfile?
  consents             UserConsent[]
  interests            UserInterest[]
  shoppingIntents      ShoppingIntent[]
  memberships          CommunityMembership[]
  posts                Post[]
  comments             Comment[]
  likes                Like[]
  savedItems           SavedItem[]
  following            Follow[]              @relation("follower")
  followers            Follow[]              @relation("following")
  media                Media[]
  aiRequests           AIRequest[]
  cart                 Cart?
  addresses            Address[]
  checkouts            Checkout[]
  orders               Order[]               @relation("buyerOrders")
  /// Sugerencias de «Gente de tus comunidades» que la persona quitó, y las veces que otros la quitaron.
  dismissedSuggestions SuggestionDismissal[] @relation("dismisser")
  dismissedBy          SuggestionDismissal[] @relation("dismissedTarget")
  // Administración y moderación (architecture.md → Administración y operación). Rol: `Profile.role`.
  reportsFiled         Report[]              @relation("reportsFiled")
  reportsResolved      Report[]              @relation("reportsResolved")
  authenticityReviews  AuthenticityCheck[]   @relation("authenticityReviewer")
  decisionsApproved    PlatformDecision[]    @relation("decisionApprover")
  // Saldo, Pruébatelo y looks (ADR-043, ADR-044, ADR-045).
  wallet               Wallet?
  tryOnPhotos          TryOnPhoto[]
  tryOnResults         TryOnResult[]
  styleLooks           StyleLook[]
  conversationsAsA     Conversation[]        @relation("conversationsAsA")
  conversationsAsB     Conversation[]        @relation("conversationsAsB")
  messagesSent         Message[]             @relation("messagesSent")

  @@map("users")
}

model Session {
  id        String   @id @default(uuid(7)) @db.Uuid
  expiresAt DateTime @db.Timestamptz(3)
  token     String   @unique
  ipAddress String?
  userAgent String?
  userId    String   @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  @@index([userId])
  @@map("sessions")
}

model Account {
  id                    String    @id @default(uuid(7)) @db.Uuid
  accountId             String
  providerId            String
  userId                String    @db.Uuid
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime? @db.Timestamptz(3)
  refreshTokenExpiresAt DateTime? @db.Timestamptz(3)
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt             DateTime  @updatedAt @db.Timestamptz(3)

  @@index([userId])
  @@map("accounts")
}

model Verification {
  id         String   @id @default(uuid(7)) @db.Uuid
  identifier String
  value      String
  expiresAt  DateTime @db.Timestamptz(3)
  createdAt  DateTime @default(now()) @db.Timestamptz(3)
  updatedAt  DateTime @updatedAt @db.Timestamptz(3)

  @@index([identifier])
  @@map("verifications")
}

model RateLimit {
  id          String @id @default(uuid(7)) @db.Uuid
  key         String @unique
  count       Int
  lastRequest BigInt

  @@map("rate_limits")
}

// Límite de frecuencia propio de la app (src/server/rate-limit.ts): Server Actions y route handlers.
// No reutiliza `RateLimit`: Better Auth borra de esa tabla toda fila con `lastRequest` más vieja que su
// ventana más larga (60 s) sin filtrar por llave, y se llevaría ventanas de 15 min o más. La llave es
// natural ("signin:email:<sha256>"), por eso no lleva UUID. Una fila por llave con ventana fija que
// empieza en el primer intento; `expiresAt` indexado para la limpieza oportunista.
model RateLimitBucket {
  key       String   @id @db.VarChar(200)
  count     Int
  expiresAt DateTime @db.Timestamptz(3)

  @@index([expiresAt])
  @@map("rate_limit_buckets")
}

/// Rol de equipo. Vive en `Profile` (no en `User`) para que ningún camino de Better Auth pueda
/// escribirlo; solo lo cambia `scripts/make-admin.ts` desde la terminal.
enum UserRole {
  USER
  ADMIN
}

enum UserGoal {
  ENTERTAINMENT
  DISCOVER
  BUY_SOMETHING
  SELL
  CREATE_CONTENT
  LEARN
}

model Profile {
  id                     String     @id @default(uuid(7)) @db.Uuid
  userId                 String     @unique @db.Uuid
  user                   User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// Siempre en minúsculas; único.
  username               String     @unique
  displayName            String
  bio                    String?
  /// URL pública de la foto de perfil (la de `avatarMedia` cuando se subió una, ADR-058).
  avatarUrl              String?
  /// Foto de perfil subida (ADR-058): pública mientras sea su foto, nunca huérfana.
  avatarMediaId          String?    @unique @db.Uuid
  avatarMedia            Media?     @relation("profileAvatar", fields: [avatarMediaId], references: [id], onDelete: SetNull)
  /// Portada propia (ADR-058). Sin ella, el perfil arma una con su última foto.
  coverMediaId           String?    @unique @db.Uuid
  coverMedia             Media?     @relation("profileCover", fields: [coverMediaId], references: [id], onDelete: SetNull)
  city                   String?
  state                  String?
  goals                  UserGoal[] @default([])
  /// Preferencia de personalización (consentimiento); si es false no se registran eventos personales.
  personalizationEnabled Boolean    @default(true)
  /// Cuenta editorial de la plataforma: se muestra identificada como tal (ADR-018).
  isEditorial            Boolean    @default(false)
  /// Aparecer en «Gente de tus comunidades» de otras personas (ajuste de privacidad, activo por omisión).
  discoverable           Boolean    @default(true)
  /// Rol de equipo. Ninguna acción, formulario ni DTO de escritura lo expone: solo se cambia con
  /// `scripts/make-admin.ts`. ADMIN abre /admin (`requireAdmin`, src/modules/admin/guard.ts).
  role                   UserRole   @default(USER)
  onboardedAt            DateTime?  @db.Timestamptz(3)
  createdAt              DateTime   @default(now()) @db.Timestamptz(3)
  updatedAt              DateTime   @updatedAt @db.Timestamptz(3)

  @@map("profiles")
}

enum PaymentMethod {
  CARD
  TRANSFER
  CASH_ON_DELIVERY
  OXXO
}

enum SellerStatus {
  ACTIVE
  SUSPENDED
}

model SellerProfile {
  id                     String          @id @default(uuid(7)) @db.Uuid
  userId                 String          @unique @db.Uuid
  user                   User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  displayName            String
  description            String?
  city                   String?
  state                  String?
  /// Métodos de pago aceptados (P4): el agente de IA solo puede citar estos.
  acceptedPaymentMethods PaymentMethod[] @default([])
  status                 SellerStatus    @default(ACTIVE)
  /// «Pruebas gratis en mis productos» (ADR-044): el vendedor paga cada Pruébatelo sobre sus
  /// productos a precio comunitario, hasta `tryOnDailyCapCents` al día.
  sponsorsTryOn          Boolean         @default(false)
  tryOnDailyCapCents     Int             @default(0)
  createdAt              DateTime        @default(now()) @db.Timestamptz(3)
  updatedAt              DateTime        @updatedAt @db.Timestamptz(3)

  products Product[]
  orders   Order[]

  @@map("seller_profiles")
}

enum ConsentType {
  TERMS
  PRIVACY_NOTICE
  PERSONALIZATION
  /// «Aparecer en sugerencias» de «Gente de tus comunidades» (Profile.discoverable).
  DISCOVERABILITY
  /// Usar la foto de la persona para las simulaciones de «Pruébatelo» (ADR-045).
  TRY_ON_PHOTOS
}

/// Historial inmutable de consentimientos: cada cambio agrega un registro.
model UserConsent {
  id        String      @id @default(uuid(7)) @db.Uuid
  userId    String      @db.Uuid
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      ConsentType
  version   String
  granted   Boolean
  createdAt DateTime    @default(now()) @db.Timestamptz(3)

  @@index([userId, type, createdAt])
  @@map("user_consents")
}

enum InterestKind {
  BRAND
  TOPIC
}

/// Gustos declarados por la persona (onboarding y microconsultas). Editables y borrables.
model UserInterest {
  id        String       @id @default(uuid(7)) @db.Uuid
  userId    String       @db.Uuid
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind      InterestKind
  /// Valor normalizado (minúsculas, sin acentos) para comparar.
  value     String
  label     String
  createdAt DateTime     @default(now()) @db.Timestamptz(3)

  @@unique([userId, kind, value])
  @@map("user_interests")
}

enum IntentSource {
  ONBOARDING
  SEARCH
  AI_COMPANION
}

enum IntentStatus {
  ACTIVE
  FULFILLED
  DISMISSED
  EXPIRED
}

/// "¿Buscas algo ahora?": intención de compra declarada; la señal más fuerte del Commerce Engine.
model ShoppingIntent {
  id             String       @id @default(uuid(7)) @db.Uuid
  userId         String       @db.Uuid
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  query          String
  categoryId     String?      @db.Uuid
  category       Category?    @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  budgetMaxCents Int?
  source         IntentSource @default(ONBOARDING)
  status         IntentStatus @default(ACTIVE)
  expiresAt      DateTime?    @db.Timestamptz(3)
  createdAt      DateTime     @default(now()) @db.Timestamptz(3)

  @@index([userId, status])
  @@map("shopping_intents")
}

// ─────────────────────────── Comunidades y contenido ───────────────────────────

model Community {
  id          String   @id @default(uuid(7)) @db.Uuid
  slug        String   @unique
  name        String
  description String
  emoji       String
  /// Tono (0–360) para el color de la comunidad en la interfaz.
  hue         Int      @default(12)
  sortOrder   Int      @default(0)
  isOfficial  Boolean  @default(true)
  memberCount Int      @default(0)
  createdAt   DateTime @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @db.Timestamptz(3)

  memberships CommunityMembership[]
  categories  CommunityCategory[]
  posts       Post[]

  @@map("communities")
}

model CommunityMembership {
  userId      String    @db.Uuid
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  communityId String    @db.Uuid
  community   Community @relation(fields: [communityId], references: [id], onDelete: Cascade)
  createdAt   DateTime  @default(now()) @db.Timestamptz(3)
  /// Última vez que la persona abrió la comunidad («N nuevas», F7). Sin visitas cuenta desde que
  /// se unió (`createdAt`). El índice de posts (communityId, status, publishedAt) sirve al conteo.
  lastSeenAt  DateTime? @db.Timestamptz(3)

  @@id([userId, communityId])
  @@index([communityId])
  @@map("community_memberships")
}

/// Conecta intereses sociales con categorías de producto (Commerce Engine).
model CommunityCategory {
  communityId String    @db.Uuid
  community   Community @relation(fields: [communityId], references: [id], onDelete: Cascade)
  categoryId  String    @db.Uuid
  category    Category  @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([communityId, categoryId])
  @@index([categoryId])
  @@map("community_categories")
}

enum MediaKind {
  IMAGE
  VIDEO
}

enum MediaStatus {
  PROCESSING
  READY
  FAILED
}

model Media {
  id          String      @id @default(uuid(7)) @db.Uuid
  ownerId     String      @db.Uuid
  owner       User        @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  kind        MediaKind   @default(IMAGE)
  /// Clave en el StorageProvider (nunca una ruta del sistema de archivos).
  storageKey  String      @unique
  mimeType    String
  width       Int
  height      Int
  sizeBytes   Int
  /// Miniatura diminuta en base64 para el efecto de carga.
  blurDataUrl String?
  altText     String?
  /// Crédito de fotos de terceros (stock con licencia libre): autor, su perfil y la fuente.
  creditName  String?
  creditUrl   String?
  /// Página original de la foto y licencia bajo la que se usa (p. ej. "Unsplash").
  sourceUrl   String?
  license     String?
  status      MediaStatus @default(READY)
  createdAt   DateTime    @default(now()) @db.Timestamptz(3)

  postLinks     PostMedia[]
  productLinks  ProductMedia[]
  /// Envíos como comprobante de autenticidad (P14): privada para siempre, nunca se adjunta.
  proofHistory  AuthenticityProofHistory[]
  /// Foto de Pruébatelo o su resultado (ADR-045): privadas, con fecha de borrado, nunca se adjuntan.
  tryOnPhoto    TryOnPhoto?
  tryOnResult   TryOnResult?               @relation("tryOnResultMedia")
  /// Foto de perfil o portada de alguien (ADR-058): públicas mientras lo sean.
  profileAvatar Profile?                   @relation("profileAvatar")
  profileCover  Profile?                   @relation("profileCover")

  @@index([ownerId, createdAt(sort: Desc)])
  @@map("media")
}

enum PostType {
  POST
  VIDEO
  PRODUCT
}

/// HIDDEN = oculta por moderación (solo el equipo la pone o la quita; ningún camino del autor la
/// toca). REMOVED = retirada de forma definitiva. Toda consulta pública ya filtra `PUBLISHED`.
enum PostStatus {
  PUBLISHED
  HIDDEN
  REMOVED
}

model Post {
  id            String     @id @default(uuid(7)) @db.Uuid
  authorId      String     @db.Uuid
  author        User       @relation(fields: [authorId], references: [id], onDelete: Cascade)
  communityId   String?    @db.Uuid
  community     Community? @relation(fields: [communityId], references: [id], onDelete: SetNull)
  type          PostType   @default(POST)
  body          String
  productId     String?    @db.Uuid
  product       Product?   @relation(fields: [productId], references: [id], onDelete: SetNull)
  status        PostStatus @default(PUBLISHED)
  /// Contenido generado o asistido por IA: se etiqueta en la interfaz (ADR-018).
  isAiGenerated Boolean    @default(false)
  likeCount     Int        @default(0)
  commentCount  Int        @default(0)
  saveCount     Int        @default(0)
  publishedAt   DateTime   @default(now()) @db.Timestamptz(3)
  createdAt     DateTime   @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime   @updatedAt @db.Timestamptz(3)

  media    PostMedia[]
  likes    Like[]
  comments Comment[]
  saves    SavedItem[]

  @@index([status, publishedAt(sort: Desc), id])
  @@index([communityId, status, publishedAt(sort: Desc)])
  @@index([authorId, publishedAt(sort: Desc)])
  @@index([productId])
  @@map("posts")
}

model PostMedia {
  postId   String @db.Uuid
  post     Post   @relation(fields: [postId], references: [id], onDelete: Cascade)
  mediaId  String @db.Uuid
  media    Media  @relation(fields: [mediaId], references: [id], onDelete: Cascade)
  position Int    @default(0)

  @@id([postId, mediaId])
  @@index([mediaId])
  @@map("post_media")
}

/// Reacciones (ADR-054): una por persona y publicación; `Post.likeCount` las cuenta todas.
enum ReactionKind {
  LIKE
  CARE
  HAHA
  WOW
  SAD
  ANGRY
}

model Like {
  userId    String       @db.Uuid
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  postId    String       @db.Uuid
  post      Post         @relation(fields: [postId], references: [id], onDelete: Cascade)
  kind      ReactionKind @default(LIKE)
  createdAt DateTime     @default(now()) @db.Timestamptz(3)

  @@id([userId, postId])
  @@index([postId])
  @@map("likes")
}

/// Igual que `PostStatus`: HIDDEN = oculto por moderación; REMOVED = retirado.
enum CommentStatus {
  PUBLISHED
  HIDDEN
  REMOVED
}

model Comment {
  id        String        @id @default(uuid(7)) @db.Uuid
  postId    String        @db.Uuid
  post      Post          @relation(fields: [postId], references: [id], onDelete: Cascade)
  authorId  String        @db.Uuid
  author    User          @relation(fields: [authorId], references: [id], onDelete: Cascade)
  body      String
  status    CommentStatus @default(PUBLISHED)
  createdAt DateTime      @default(now()) @db.Timestamptz(3)
  updatedAt DateTime      @updatedAt @db.Timestamptz(3)

  @@index([postId, createdAt])
  @@map("comments")
}

model Follow {
  followerId  String   @db.Uuid
  follower    User     @relation("follower", fields: [followerId], references: [id], onDelete: Cascade)
  followingId String   @db.Uuid
  following   User     @relation("following", fields: [followingId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now()) @db.Timestamptz(3)

  @@id([followerId, followingId])
  @@index([followingId])
  @@map("follows")
}

/// Persona que alguien quitó de «Gente de tus comunidades»: no se le vuelve a sugerir.
model SuggestionDismissal {
  userId       String   @db.Uuid
  user         User     @relation("dismisser", fields: [userId], references: [id], onDelete: Cascade)
  targetUserId String   @db.Uuid
  target       User     @relation("dismissedTarget", fields: [targetUserId], references: [id], onDelete: Cascade)
  createdAt    DateTime @default(now()) @db.Timestamptz(3)

  @@id([userId, targetUserId])
  @@index([targetUserId])
  @@map("suggestion_dismissals")
}

/// Guardado de una publicación o de un producto (exactamente uno; restricción CHECK en la migración).
model SavedItem {
  id        String   @id @default(uuid(7)) @db.Uuid
  userId    String   @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  postId    String?  @db.Uuid
  post      Post?    @relation(fields: [postId], references: [id], onDelete: Cascade)
  productId String?  @db.Uuid
  product   Product? @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now()) @db.Timestamptz(3)

  @@unique([userId, postId])
  @@unique([userId, productId])
  @@index([userId, createdAt(sort: Desc)])
  @@map("saved_items")
}

// ─────────────────────────────── Catálogo ───────────────────────────────

model Category {
  id        String     @id @default(uuid(7)) @db.Uuid
  slug      String     @unique
  name      String
  parentId  String?    @db.Uuid
  parent    Category?  @relation("CategoryTree", fields: [parentId], references: [id], onDelete: SetNull)
  children  Category[] @relation("CategoryTree")
  sortOrder Int        @default(0)
  createdAt DateTime   @default(now()) @db.Timestamptz(3)

  products        Product[]
  communities     CommunityCategory[]
  shoppingIntents ShoppingIntent[]

  @@index([parentId])
  @@map("categories")
}

enum ProductStatus {
  DRAFT
  ACTIVE
  PAUSED
  SOLD_OUT
  ARCHIVED
}

enum ProductCondition {
  NEW
  LIKE_NEW
  USED_GOOD
  USED_FAIR
  REFURBISHED
}

enum WarrantyType {
  NONE
  SELLER
  MANUFACTURER
}

enum Authenticity {
  NOT_APPLICABLE
  DECLARED_ORIGINAL
  GENERIC
}

/// Moderación de un producto, independiente de `ProductStatus` (que controla el vendedor).
enum ModerationStatus {
  VISIBLE
  HIDDEN
}

model Product {
  id                        String           @id @default(uuid(7)) @db.Uuid
  sellerId                  String           @db.Uuid
  seller                    SellerProfile    @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  slug                      String           @unique
  title                     String
  description               String
  priceCents                Int
  compareAtPriceCents       Int?
  currency                  String           @default("MXN") @db.Char(3)
  stock                     Int              @default(0)
  status                    ProductStatus    @default(ACTIVE)
  condition                 ProductCondition @default(NEW)
  categoryId                String           @db.Uuid
  category                  Category         @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  tags                      String[]         @default([])
  /// Ubicación pública solo a nivel ciudad/estado (privacidad).
  city                      String
  state                     String
  // Datos verificables de entrega, garantía y autenticidad (P4, ADR-007).
  pickupAvailable           Boolean          @default(false)
  localDeliveryAvailable    Boolean          @default(false)
  localDeliveryZones        String[]         @default([])
  nationalShippingAvailable Boolean          @default(false)
  /// Costo de envío nacional en centavos; 0 = envío gratis; null = no aplica.
  shippingPriceCents        Int?
  deliveryMinDays           Int?
  deliveryMaxDays           Int?
  warrantyType              WarrantyType     @default(NONE)
  warrantyDays              Int?
  /// Días para devolver; 0 = sin devoluciones.
  returnWindowDays          Int              @default(0)
  authenticity              Authenticity     @default(NOT_APPLICABLE)
  /// HIDDEN lo saca del feed, la búsqueda, Comprar, «similares» y su página pública (el vendedor lo
  /// sigue viendo en Studio). Solo lo cambia el equipo (reporte o revisión de autenticidad), nunca el
  /// vendedor: sus acciones de estado no tocan este campo.
  moderationStatus          ModerationStatus @default(VISIBLE)
  moderatedAt               DateTime?        @db.Timestamptz(3)
  saveCount                 Int              @default(0)
  /// Destacado (ADR-046): hasta esta fecha aparece como «Patrocinado» junto a otros productos. Lo
  /// paga el vendedor por día desde su saldo; oculto por moderación no se muestra aunque siga vigente.
  featuredUntil             DateTime?        @db.Timestamptz(3)
  publishedAt               DateTime?        @db.Timestamptz(3)
  createdAt                 DateTime         @default(now()) @db.Timestamptz(3)
  updatedAt                 DateTime         @updatedAt @db.Timestamptz(3)

  cost       ProductCost?
  media      ProductMedia[]
  posts      Post[]
  saves      SavedItem[]
  cartItems  CartItem[]
  orderItems OrderItem[]

  authenticityCheck AuthenticityCheck?
  proofHistory      AuthenticityProofHistory[]

  @@index([status, categoryId, createdAt(sort: Desc)])
  @@index([sellerId, status])
  @@index([featuredUntil])
  @@map("products")
}

/// Costo interno del producto. Tabla aparte para que ninguna consulta pública lo incluya por error.
model ProductCost {
  productId     String   @id @db.Uuid
  product       Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  unitCostCents Int
  updatedAt     DateTime @updatedAt @db.Timestamptz(3)

  @@map("product_costs")
}

model ProductMedia {
  productId String  @db.Uuid
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  mediaId   String  @db.Uuid
  media     Media   @relation(fields: [mediaId], references: [id], onDelete: Cascade)
  position  Int     @default(0)

  @@id([productId, mediaId])
  @@index([mediaId])
  @@map("product_media")
}

// ──────────────────────────────── IA ────────────────────────────────

enum AIFeature {
  SALE_PROPOSAL
  CONTENT_GENERATION
  CAMPAIGN_STRATEGY
  /// Analista diario del motor de automejora (solo agregados).
  PLATFORM_ANALYSIS
  /// Señal de IA en la revisión de autenticidad (`AuthenticityCheck.aiSignal`).
  AUTHENTICITY_REVIEW
  /// Casos de evaluación para elegir modelo por tarea (`AIEvalRun`); cuentan en el presupuesto.
  MODEL_EVALUATION
  /// «¿Qué necesitas?»: interpretar una necesidad en lenguaje natural (estilista, ADR-043).
  SHOPPING_INTENT
  /// Nombre y explicación de un look armado por código (estilista).
  LOOK_COPY
  /// «Pruébatelo»: una imagen generada con la foto de la persona y los productos (ADR-045).
  VIRTUAL_TRY_ON
}

/// Quién financia una solicitud de IA (ADR-044). Solo PLATFORM y SYSTEM consumen el presupuesto
/// de subsidio (`ai.budget`); lo pagado lo financia el saldo de quien lo pidió o lo patrocinó.
enum AIFunding {
  /// Subsidio de la plataforma, incluidas las pruebas gratis del mes.
  PLATFORM
  /// La persona la pagó con su saldo.
  USER_PAID
  /// Un vendedor la patrocinó con su saldo.
  SELLER_PAID
  /// Tareas del sistema (analista, evaluaciones).
  SYSTEM
}

enum AIRequestStatus {
  PENDING
  SUCCEEDED
  FAILED
  BLOCKED_BUDGET
}

model AIRequest {
  id            String          @id @default(uuid(7)) @db.Uuid
  userId        String?         @db.Uuid
  user          User?           @relation(fields: [userId], references: [id], onDelete: SetNull)
  feature       AIFeature
  provider      String
  model         String
  promptVersion String
  /// Entrada saneada (sin datos sensibles innecesarios).
  input         Json
  /// Quién la financia (ADR-044): decide si cuenta en el presupuesto de subsidio.
  funding       AIFunding       @default(PLATFORM)
  status        AIRequestStatus @default(PENDING)
  errorCode     String?
  latencyMs     Int?
  createdAt     DateTime        @default(now()) @db.Timestamptz(3)

  response    AIResponse?
  tryOnResult TryOnResult?

  @@index([userId, createdAt(sort: Desc)])
  @@index([feature, createdAt(sort: Desc)])
  @@map("ai_requests")
}

model AIResponse {
  id            String    @id @default(uuid(7)) @db.Uuid
  requestId     String    @unique @db.Uuid
  request       AIRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  /// Salida ya validada con su esquema de Zod.
  output        Json
  inputTokens   Int       @default(0)
  outputTokens  Int       @default(0)
  /// Costo en micro-dólares (1 USD = 1,000,000) para medir el autofinanciamiento (ADR-020).
  costMicrosUsd Int       @default(0)
  createdAt     DateTime  @default(now()) @db.Timestamptz(3)

  @@map("ai_responses")
}

// ───────────────────────────── Eventos (P5) ─────────────────────────────

enum AnalyticsEventType {
  IMPRESSION
  VIEW
  CLICK
  SEARCH
  LIKE
  UNLIKE
  SAVE
  UNSAVE
  COMMENT
  FOLLOW
  SHARE
  NOT_INTERESTED
  COMMUNITY_JOIN
  PRODUCT_VIEW
  ADD_TO_CART
  CHECKOUT_STARTED
  PURCHASE
  SIGN_UP
  ONBOARDING_COMPLETED
  AI_PROPOSAL_GENERATED
  AI_PROPOSAL_ACCEPTED
  /// La persona vio la variante que le tocó de un experimento (`metadata.experiment`, `.variant`).
  EXPERIMENT_EXPOSURE
  /// Impresión VISIBLE del feed (T5, ADR-037): ≥ 50 % de la pieza en pantalla durante ≥ 1 s
  /// continuo, medida en el navegador y aceptada solo si la pieza se le sirvió a esa persona
  /// (`analytics/visible-impressions.ts`). `IMPRESSION` sigue siendo la pieza SERVIDA.
  VISIBLE_IMPRESSION
  /// Estilista (ADR-043): la persona describió una necesidad («¿Qué necesitas?»).
  NEED_SUBMITTED
  /// Se armó un look con productos reales (`metadata.items`, `metadata.source`).
  LOOK_GENERATED
  /// La persona cambió una pieza del look («quiero otros zapatos»).
  LOOK_ITEM_SWAPPED
  /// Se generó una simulación de Pruébatelo (`metadata.funding`, `metadata.cached`).
  TRY_ON_GENERATED
  /// Alguien quiso probarse un producto cuya tienda no tiene pruebas activas (ADR-046): la demanda
  /// que ve el vendedor en su Studio.
  TRY_ON_REQUESTED
  /// Recarga de saldo (`metadata.packId`, `metadata.simulated`).
  WALLET_TOPUP
  /// Cargo al saldo por un uso pagado (`metadata.kind`).
  WALLET_CHARGE
}

enum EntityType {
  POST
  PRODUCT
  PROFILE
  COMMUNITY
  CATEGORY
}

enum Surface {
  FEED
  COMMUNITY
  DISCOVER
  SHOP
  PROFILE
  PRODUCT_PAGE
  POST_PAGE
  SHARE_LINK
  STUDIO
  ONBOARDING
  /// Estilista: «¿Qué necesitas?», looks y Pruébatelo.
  STYLIST
  /// Saldo y recargas.
  WALLET
}

/// Sin llave foránea a User a propósito: se escribe en segundo plano y se borra por userId al
/// ejercer el derecho de cancelación.
model AnalyticsEvent {
  id               String             @id @default(uuid(7)) @db.Uuid
  type             AnalyticsEventType
  userId           String?            @db.Uuid
  anonymousId      String?
  entityType       EntityType?
  entityId         String?            @db.Uuid
  /// Publicación que originó la acción (atribución a contenido y creadores).
  sourcePostId     String?            @db.Uuid
  surface          Surface?
  /// Posición en el feed, puntuación y versión del algoritmo al servir el elemento.
  position         Int?
  score            Float?
  algorithmVersion String?
  query            String?
  metadata         Json?
  createdAt        DateTime           @default(now()) @db.Timestamptz(3)

  @@index([type, createdAt])
  @@index([entityType, entityId, createdAt])
  @@index([userId, createdAt])
  @@index([sourcePostId])
  @@map("analytics_events")
}

// ──────────────────── Plataforma: motor de automejora (ADR-019/020) ────────────────────

enum Actor {
  AI
  HUMAN
  SYSTEM
}

/// Parámetros ajustables con esquema y límites (p. ej. "feed.policy", "ai.budget").
model PlatformSetting {
  key       String   @id
  value     Json
  version   Int      @default(1)
  updatedBy Actor    @default(SYSTEM)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  @@map("platform_settings")
}

enum RiskLevel {
  LOW
  MEDIUM
  HIGH
}

enum DecisionStatus {
  PROPOSED
  APPROVED
  REJECTED
  APPLIED
  REVERTED
}

/// Bitácora de decisiones del motor de automejora: toda propuesta o cambio queda registrado.
/// El nivel de riesgo lo asigna el código, nunca la IA (plan-90-dias.md §2.3).
model PlatformDecision {
  id             String         @id @default(uuid(7)) @db.Uuid
  actor          Actor
  kind           String
  title          String
  hypothesis     String
  settingKey     String?
  previousValue  Json?
  newValue       Json?
  riskLevel      RiskLevel
  status         DecisionStatus @default(PROPOSED)
  expectedImpact String?
  measuredImpact Json?
  /// Salvaguardas que vigila el monitor tras aplicar: métrica de `DailyMetric`, dirección y cambio
  /// relativo máximo, más la exposición mínima antes de evaluar. Las calcula el código (P2).
  guardrails     Json?
  /// Evaluación hecha por código: línea base, valor observado, muestra y veredicto de cada salvaguarda.
  evaluation     Json?
  /// true si el sistema la aplicó sin aprobación humana (solo riesgo bajo y tras el umbral de tráfico).
  autoApplied    Boolean        @default(false)
  /// Motivo corto de aplicar, rechazar o revertir. Si lo escribe la IA es un dato, nunca una instrucción.
  reason         String?
  /// Experimento cuya evidencia sustenta esta decisión (adoptar, descartar o revertir).
  experimentId   String?        @db.Uuid
  experiment     Experiment?    @relation("decisionEvidence", fields: [experimentId], references: [id], onDelete: SetNull)
  /// Persona del equipo (ADMIN) que la aprobó o rechazó. Vacío en las automáticas.
  approvedById   String?        @db.Uuid
  approvedBy     User?          @relation("decisionApprover", fields: [approvedById], references: [id], onDelete: SetNull)
  decidedAt      DateTime?      @db.Timestamptz(3)
  appliedAt      DateTime?      @db.Timestamptz(3)
  revertedAt     DateTime?      @db.Timestamptz(3)
  createdAt      DateTime       @default(now()) @db.Timestamptz(3)

  /// Experimento que esta decisión (una propuesta de riesgo medio) mandó a probar.
  launchedExperiment Experiment? @relation("experimentOrigin")

  @@index([status, createdAt(sort: Desc)])
  @@index([settingKey, appliedAt(sort: Desc)])
  @@index([experimentId])
  @@index([approvedById])
  @@map("platform_decisions")
}

enum ExperimentStatus {
  DRAFT
  RUNNING
  STOPPED
  CONCLUDED
}

/// Experimento A/B sobre un ajuste de plataforma. Asignación estable POR PERSONA (hash de la persona
/// y `key`, sin tabla de asignaciones) y análisis por persona o con errores robustos por clúster
/// (plan-90-dias.md §2.4). A lo más uno RUNNING por `settingKey` (índice parcial en la migración).
model Experiment {
  id                  String            @id @default(uuid(7)) @db.Uuid
  /// Identificador estable (entra en el hash de asignación: no se reutiliza).
  key                 String            @unique @db.VarChar(100)
  settingKey          String            @db.VarChar(100)
  hypothesis          String
  status              ExperimentStatus  @default(DRAFT)
  /// `{ control: <valor>, treatment: <valor> }`, cada uno validado con el esquema del ajuste.
  variants            Json
  /// Fracción (0–1) de las personas elegibles que va al tratamiento. CHECK en la migración.
  allocation          Float
  /// Impresiones visibles (o unidad de `primaryMetric`) por variante antes de concluir; ≈ 41,000
  /// para el CTR del feed con efecto de diseño 1.95 (plan-90-dias.md §2.4). CHECK > 0.
  minSamplePerVariant Int
  /// Llave de `DailyMetric` que decide (p. ej. "feed.commerce.ctr").
  primaryMetric       String            @db.VarChar(100)
  /// Salvaguardas, mismo formato que `PlatformDecision.guardrails`.
  guardrails          Json
  startedAt           DateTime?         @db.Timestamptz(3)
  endedAt             DateTime?         @db.Timestamptz(3)
  /// Resultado calculado por código: muestra, efecto, intervalo y salvaguardas por variante.
  result              Json?
  /// Decisión que lo originó (propuesta de riesgo medio aprobada).
  decisionId          String?           @unique @db.Uuid
  decision            PlatformDecision? @relation("experimentOrigin", fields: [decisionId], references: [id], onDelete: SetNull)
  createdAt           DateTime          @default(now()) @db.Timestamptz(3)
  updatedAt           DateTime          @updatedAt @db.Timestamptz(3)

  /// Decisiones que se tomaron con su evidencia (adoptar, descartar, revertir).
  outcomeDecisions PlatformDecision[] @relation("decisionEvidence")

  @@index([status, settingKey])
  @@map("experiments")
}

/// Agregado diario calculado por código (P2) a partir de eventos, reportes, productos e IA. `day` es
/// el día calendario de America/Mexico_City: cubre de 00:00 a 24:00 hora del centro de México
/// (06:00Z a 06:00Z del día siguiente; sin horario de verano desde 2022). Se recalcula con upsert
/// sobre (day, key, dimension), así que la tarea es idempotente.
model DailyMetric {
  id         String   @id @default(uuid(7)) @db.Uuid
  day        DateTime @db.Date
  /// Nombre con puntos: "feed.impressions.visible", "feed.commerce.ctr", "sellers.active", …
  key        String   @db.VarChar(100)
  /// Corte opcional ("" = total): "variant:<experimento>:<variante>", "community:<slug>", …
  dimension  String   @default("") @db.VarChar(200)
  value      Float
  /// Tamaño de la muestra detrás del valor (denominador de una tasa o número de eventos). CHECK ≥ 0.
  sampleSize Int
  createdAt  DateTime @default(now()) @db.Timestamptz(3)
  updatedAt  DateTime @updatedAt @db.Timestamptz(3)

  @@unique([day, key, dimension])
  @@index([key, day])
  @@map("daily_metrics")
}

enum JobStatus {
  RUNNING
  SUCCEEDED
  FAILED
}

/// Bitácora de tareas programadas (`/api/cron/*`). Una fila por ejecución; una RUNNING vieja sin
/// `finishedAt` es una tarea que murió (alerta).
model JobRun {
  id         String    @id @default(uuid(7)) @db.Uuid
  /// Nombre estable de la tarea, p. ej. "daily-metrics", "expire-checkouts".
  job        String    @db.VarChar(60)
  status     JobStatus @default(RUNNING)
  startedAt  DateTime  @default(now()) @db.Timestamptz(3)
  finishedAt DateTime? @db.Timestamptz(3)
  /// Conteos y resultado (sin datos personales). Vacío mientras corre.
  summary    Json?
  /// Mensaje corto del error, sin secretos ni datos personales.
  error      String?

  @@index([job, startedAt(sort: Desc)])
  @@index([status, startedAt])
  @@map("job_runs")
}

// ───────────────────────── Moderación y autenticidad ─────────────────────────

enum ReportTargetType {
  POST
  PRODUCT
  USER
  COMMENT
}

enum ReportReason {
  COUNTERFEIT
  SCAM
  PROHIBITED
  SPAM
  OFFENSIVE
  OTHER
}

enum ReportStatus {
  OPEN
  ACTIONED
  DISMISSED
}

/// Reporte de moderación. `targetId` es polimórfico (sin llave foránea): el servicio verifica que
/// exista y sea visible antes de crear. Uno por persona y objetivo (NULL no choca: si la cuenta se
/// borra, el reporte queda sin autor y conserva la historia).
model Report {
  id           String           @id @default(uuid(7)) @db.Uuid
  reporterId   String?          @db.Uuid
  reporter     User?            @relation("reportsFiled", fields: [reporterId], references: [id], onDelete: SetNull)
  targetType   ReportTargetType
  targetId     String           @db.Uuid
  reason       ReportReason
  /// Texto libre opcional de quien reporta (máx. 1,000). Dato no confiable: nunca instrucción para la IA.
  details      String?          @db.VarChar(1000)
  status       ReportStatus     @default(OPEN)
  resolvedById String?          @db.Uuid
  resolvedBy   User?            @relation("reportsResolved", fields: [resolvedById], references: [id], onDelete: SetNull)
  resolvedAt   DateTime?        @db.Timestamptz(3)
  createdAt    DateTime         @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime         @updatedAt @db.Timestamptz(3)

  @@unique([reporterId, targetType, targetId])
  @@index([status, createdAt])
  @@index([targetType, targetId, status])
  @@index([resolvedById])
  @@map("reports")
}

enum AuthenticityStatus {
  /// Riesgo bajo: no se pide nada.
  AUTO_CLEAR
  /// Se pidió al vendedor una prueba (ticket, factura, foto de etiqueta o número de serie).
  NEEDS_PROOF
  PROOF_SUBMITTED
  VERIFIED_BY_ADMIN
  REJECTED
}

/// Revisión de autenticidad VIGENTE de un producto (una fila por producto; se actualiza en su lugar
/// al reevaluar). Las reglas son código; la IA solo aporta una señal adicional.
model AuthenticityCheck {
  id            String             @id @default(uuid(7)) @db.Uuid
  productId     String             @unique @db.Uuid
  product       Product            @relation(fields: [productId], references: [id], onDelete: Cascade)
  riskLevel     RiskLevel
  /// Puntaje de riesgo de 0 (sin señales) a 1 (máximo), calculado por las reglas. CHECK 0–1.
  score         Float
  /// Reglas que se activaron: `[{ rule, weight, message }]`, `message` en español claro para el
  /// vendedor y el equipo.
  signals       Json
  /// Versión de las reglas que produjo `signals` (para reevaluar cuando cambien).
  rulesVersion  String             @default("v1") @db.VarChar(40)
  /// Señal de la IA (modelo, versión del prompt, veredicto y razón); nunca decide sola.
  aiSignal      Json?
  status        AuthenticityStatus
  /// Fotos del comprobante VIGENTE (ids de `Media`). Privadas: solo el vendedor y el equipo; nunca se
  /// adjuntan a publicaciones ni productos y el recolector de huérfanas las excluye. Los envíos
  /// anteriores quedan en `AuthenticityProofHistory` con la misma protección. Índice GIN: `/media`,
  /// el recolector y la validación de adjuntos preguntan «¿esta foto es un comprobante?».
  proofMediaIds String[]           @default([]) @db.Uuid
  reviewedById  String?            @db.Uuid
  reviewedBy    User?              @relation("authenticityReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  reviewedAt    DateTime?          @db.Timestamptz(3)
  /// Nota del equipo para el vendedor al verificar o rechazar (se le muestra).
  reviewNote    String?            @db.VarChar(500)
  createdAt     DateTime           @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime           @updatedAt @db.Timestamptz(3)

  @@index([status, updatedAt])
  @@index([reviewedById])
  @@index([proofMediaIds], type: Gin)
  @@map("authenticity_checks")
}

/// Bitácora de comprobantes (P14, auditoría): una fila por foto en cada envío del vendedor, con
/// cuándo se envió y cuándo la reemplazó otro envío (`replacedAt`; `null` = parte del comprobante
/// vigente). Reemplazar un comprobante no libera las fotos anteriores: siguen privadas (`/media` solo
/// a su dueño), no se pueden adjuntar a publicaciones ni productos (trigger en `post_media` y
/// `product_media`) y el recolector de huérfanas no las borra. Se borran solo con su producto o con la
/// cuenta de su dueño (cascada).
model AuthenticityProofHistory {
  id          String    @id @default(uuid(7)) @db.Uuid
  productId   String    @db.Uuid
  product     Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  mediaId     String    @db.Uuid
  media       Media     @relation(fields: [mediaId], references: [id], onDelete: Cascade)
  submittedAt DateTime  @db.Timestamptz(3)
  replacedAt  DateTime? @db.Timestamptz(3)

  @@index([mediaId])
  @@index([productId, submittedAt])
  @@map("authenticity_proof_history")
}

// ──────────────────────── IA: evaluación de modelos ────────────────────────

/// Corrida de evaluación de un modelo en una tarea: base para elegir el modelo más barato que pase
/// (ADR-033 #9: 0 cifras inventadas, JSON válido, ≥ 90 % de categoría correcta).
model AIEvalRun {
  id            String   @id @default(uuid(7)) @db.Uuid
  provider      String   @db.VarChar(60)
  model         String   @db.VarChar(128)
  promptVersion String   @db.VarChar(60)
  /// Tarea evaluada; se recomienda el nombre de `AIFeature` (p. ej. "SALE_PROPOSAL").
  task          String   @db.VarChar(60)
  /// Casos evaluados y aprobados (CHECK 0 ≤ passed ≤ cases).
  cases         Int
  passed        Int
  /// Métricas por criterio (JSON válido, cifras inventadas, categoría correcta, latencia…).
  metrics       Json
  /// Costo total de la corrida en micro-dólares (también queda en `AIRequest`/`AIResponse`).
  costMicrosUsd Int
  createdAt     DateTime @default(now()) @db.Timestamptz(3)

  @@index([task, model, createdAt(sort: Desc)])
  @@map("ai_eval_runs")
}

// ─────────────────────────── Comercio (fases 8–9) ───────────────────────────

model Cart {
  id        String     @id @default(uuid(7)) @db.Uuid
  userId    String     @unique @db.Uuid
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  items     CartItem[]
  createdAt DateTime   @default(now()) @db.Timestamptz(3)
  updatedAt DateTime   @updatedAt @db.Timestamptz(3)

  @@map("carts")
}

model CartItem {
  id           String   @id @default(uuid(7)) @db.Uuid
  cartId       String   @db.Uuid
  cart         Cart     @relation(fields: [cartId], references: [id], onDelete: Cascade)
  productId    String   @db.Uuid
  product      Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  quantity     Int
  /// Publicación que llevó a agregarlo (atribución, P5).
  sourcePostId String?  @db.Uuid
  addedAt      DateTime @default(now()) @db.Timestamptz(3)

  @@unique([cartId, productId])
  @@map("cart_items")
}

model Address {
  id             String   @id @default(uuid(7)) @db.Uuid
  userId         String   @db.Uuid
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  recipientName  String
  phone          String
  street         String
  exteriorNumber String
  interiorNumber String?
  /// Colonia.
  neighborhood   String
  city           String
  state          String
  postalCode     String   @db.Char(5)
  references     String?
  isDefault      Boolean  @default(false)
  createdAt      DateTime @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime @updatedAt @db.Timestamptz(3)

  @@index([userId])
  @@map("addresses")
}

enum CheckoutStatus {
  PENDING_PAYMENT
  PAID
  FAILED
  EXPIRED
}

/// Un pago que agrupa una orden por vendedor (ADR-011).
model Checkout {
  id            String         @id @default(uuid(7)) @db.Uuid
  buyerId       String         @db.Uuid
  buyer         User           @relation(fields: [buyerId], references: [id], onDelete: Cascade)
  status        CheckoutStatus @default(PENDING_PAYMENT)
  totalCents    Int
  currency      String         @default("MXN") @db.Char(3)
  paymentMethod PaymentMethod
  expiresAt     DateTime       @db.Timestamptz(3)
  createdAt     DateTime       @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime       @updatedAt @db.Timestamptz(3)

  orders   Order[]
  payments Payment[]

  @@index([buyerId, createdAt(sort: Desc)])
  @@index([status, expiresAt])
  @@map("checkouts")
}

enum OrderStatus {
  PENDING_PAYMENT
  PAID
  SHIPPED
  DELIVERED
  CANCELLED
}

enum DeliveryMethod {
  NATIONAL_SHIPPING
  LOCAL_DELIVERY
  PICKUP
}

model Order {
  id               String         @id @default(uuid(7)) @db.Uuid
  checkoutId       String         @db.Uuid
  checkout         Checkout       @relation(fields: [checkoutId], references: [id], onDelete: Cascade)
  buyerId          String         @db.Uuid
  buyer            User           @relation("buyerOrders", fields: [buyerId], references: [id], onDelete: Cascade)
  sellerId         String         @db.Uuid
  seller           SellerProfile  @relation(fields: [sellerId], references: [id], onDelete: Restrict)
  status           OrderStatus    @default(PENDING_PAYMENT)
  deliveryMethod   DeliveryMethod
  subtotalCents    Int
  shippingCents    Int
  platformFeeCents Int
  totalCents       Int
  currency         String         @default("MXN") @db.Char(3)
  /// Copia de la dirección al momento de comprar (no cambia si la persona edita la suya).
  shippingAddress  Json?
  paidAt           DateTime?      @db.Timestamptz(3)
  shippedAt        DateTime?      @db.Timestamptz(3)
  deliveredAt      DateTime?      @db.Timestamptz(3)
  createdAt        DateTime       @default(now()) @db.Timestamptz(3)
  updatedAt        DateTime       @updatedAt @db.Timestamptz(3)

  items OrderItem[]

  @@index([sellerId, createdAt(sort: Desc)])
  @@index([buyerId, createdAt(sort: Desc)])
  @@index([checkoutId])
  @@map("orders")
}

/// Precio, costo y comisión se congelan al comprar (P2: el beneficio se calcula con estos datos).
model OrderItem {
  id             String  @id @default(uuid(7)) @db.Uuid
  orderId        String  @db.Uuid
  order          Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId      String  @db.Uuid
  product        Product @relation(fields: [productId], references: [id], onDelete: Restrict)
  titleSnapshot  String
  unitPriceCents Int
  /// Privado del vendedor: nunca se muestra a compradores.
  unitCostCents  Int
  quantity       Int
  commissionBps  Int
  sourcePostId   String? @db.Uuid

  @@index([orderId])
  @@index([productId])
  @@index([sourcePostId])
  @@map("order_items")
}

enum PaymentStatus {
  PENDING
  APPROVED
  DECLINED
  EXPIRED
  REFUNDED
}

model Payment {
  id          String         @id @default(uuid(7)) @db.Uuid
  checkoutId  String         @db.Uuid
  checkout    Checkout       @relation(fields: [checkoutId], references: [id], onDelete: Cascade)
  provider    String
  providerRef String         @unique
  status      PaymentStatus  @default(PENDING)
  amountCents Int
  currency    String         @default("MXN") @db.Char(3)
  method      PaymentMethod
  createdAt   DateTime       @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime       @updatedAt @db.Timestamptz(3)
  events      PaymentEvent[]

  @@index([checkoutId])
  @@map("payments")
}

/// Idempotencia de notificaciones del proveedor de pagos: cada evento se procesa una sola vez.
model PaymentEvent {
  id              String   @id @default(uuid(7)) @db.Uuid
  paymentId       String?  @db.Uuid
  payment         Payment? @relation(fields: [paymentId], references: [id], onDelete: SetNull)
  provider        String
  providerEventId String
  status          String
  payload         Json
  receivedAt      DateTime @default(now()) @db.Timestamptz(3)

  @@unique([provider, providerEventId])
  @@map("payment_events")
}

enum LedgerKind {
  COMMISSION
  SUBSCRIPTION
  PROMOTION
  AI_PREMIUM
  AI_COST
  INFRA_COST
  PAYMENT_FEE
}

/// Libro de la plataforma: ingresos (positivos) y costos (negativos) para medir la cobertura de la
/// IA (ADR-020).
model PlatformLedgerEntry {
  id          String     @id @default(uuid(7)) @db.Uuid
  kind        LedgerKind
  amountCents Int
  currency    String     @default("MXN") @db.Char(3)
  reference   String?
  occurredAt  DateTime   @default(now()) @db.Timestamptz(3)
  createdAt   DateTime   @default(now()) @db.Timestamptz(3)

  @@index([kind, occurredAt])
  @@map("platform_ledger_entries")
}

// ─────────────────────────── Mensajes privados (ADR-047) ───────────────────────────

/// Conversación entre dos personas. Los ids van ordenados (`userAId` < `userBId`) para que cada par
/// tenga una sola conversación. `aReadAt`/`bReadAt`: hasta cuándo leyó cada quien (no leídos =
/// mensajes del otro después de esa fecha). Sin borrado lógico: al borrar la cuenta se van en cascada.
model Conversation {
  id            String    @id @default(uuid(7)) @db.Uuid
  userAId       String    @db.Uuid
  userA         User      @relation("conversationsAsA", fields: [userAId], references: [id], onDelete: Cascade)
  userBId       String    @db.Uuid
  userB         User      @relation("conversationsAsB", fields: [userBId], references: [id], onDelete: Cascade)
  aReadAt       DateTime? @db.Timestamptz(3)
  bReadAt       DateTime? @db.Timestamptz(3)
  lastMessageAt DateTime  @default(now()) @db.Timestamptz(3)
  createdAt     DateTime  @default(now()) @db.Timestamptz(3)

  messages Message[]

  @@unique([userAId, userBId])
  @@index([userAId, lastMessageAt(sort: Desc)])
  @@index([userBId, lastMessageAt(sort: Desc)])
  @@map("conversations")
}

/// Un mensaje de texto (máx. 2,000). Dato privado: solo lo ven las dos personas de la conversación.
model Message {
  id             String       @id @default(uuid(7)) @db.Uuid
  conversationId String       @db.Uuid
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  senderId       String       @db.Uuid
  sender         User         @relation("messagesSent", fields: [senderId], references: [id], onDelete: Cascade)
  body           String       @db.VarChar(2000)
  createdAt      DateTime     @default(now()) @db.Timestamptz(3)

  @@index([conversationId, createdAt])
  @@map("messages")
}

// ─────────────────────────── Saldo (ADR-044) ───────────────────────────

/// Una cartera por cuenta (P6), en centavos MXN. El saldo nunca baja de cero (CHECK en la
/// migración) y cada cambio deja un movimiento en `WalletEntry`.
model Wallet {
  id           String   @id @default(uuid(7)) @db.Uuid
  userId       String   @unique @db.Uuid
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  balanceCents Int      @default(0)
  currency     String   @default("MXN") @db.Char(3)
  createdAt    DateTime @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime @updatedAt @db.Timestamptz(3)

  entries WalletEntry[]
  topUps  WalletTopUp[]

  @@map("wallets")
}

enum WalletEntryKind {
  /// Recarga pagada (o simulada: `simulated`).
  TOPUP
  /// Bono de una recarga: no es ingreso.
  PROMO
  /// Cargo por una prueba de Pruébatelo pagada por la persona.
  TRY_ON
  /// Cargo al vendedor por una prueba patrocinada sobre sus productos.
  SPONSORED_TRY_ON
  /// Cargo al vendedor por días de producto destacado (ADR-046).
  FEATURED
  /// Devolución de un cargo cuya generación falló.
  REFUND
  /// Ajuste del equipo, con referencia.
  ADJUSTMENT
}

/// Libro de movimientos del saldo: inmutable, con el saldo resultante para auditar.
model WalletEntry {
  id                String          @id @default(uuid(7)) @db.Uuid
  walletId          String          @db.Uuid
  wallet            Wallet          @relation(fields: [walletId], references: [id], onDelete: Cascade)
  kind              WalletEntryKind
  /// Positivo abona, negativo carga (centavos MXN).
  amountCents       Int
  balanceAfterCents Int
  /// Id de la recarga, de la solicitud de IA o del resultado de Pruébatelo.
  reference         String?         @db.VarChar(80)
  /// El abono vino de una recarga simulada (ADR-032): no cuenta como ingreso.
  simulated         Boolean         @default(false)
  createdAt         DateTime        @default(now()) @db.Timestamptz(3)

  @@index([walletId, createdAt(sort: Desc)])
  @@index([kind, createdAt])
  @@map("wallet_entries")
}

enum TopUpStatus {
  PENDING
  PAID
  FAILED
  EXPIRED
}

/// Recarga de saldo por el `PaymentProvider`. Con el simulado queda `simulated` y no es ingreso.
model WalletTopUp {
  id          String      @id @default(uuid(7)) @db.Uuid
  walletId    String      @db.Uuid
  wallet      Wallet      @relation(fields: [walletId], references: [id], onDelete: Cascade)
  packId      String      @db.VarChar(40)
  amountCents Int
  bonusCents  Int         @default(0)
  currency    String      @default("MXN") @db.Char(3)
  status      TopUpStatus @default(PENDING)
  provider    String      @db.VarChar(40)
  providerRef String?     @unique
  simulated   Boolean     @default(false)
  paidAt      DateTime?   @db.Timestamptz(3)
  createdAt   DateTime    @default(now()) @db.Timestamptz(3)

  @@index([walletId, createdAt(sort: Desc)])
  @@map("wallet_top_ups")
}

// ─────────────────────────── Pruébatelo (ADR-045) ───────────────────────────

/// Foto de la persona para las simulaciones: privada (solo su dueña o dueño la ve), con
/// consentimiento versionado y fecha de borrado (30 días). Nunca se adjunta a nada público.
model TryOnPhoto {
  id             String   @id @default(uuid(7)) @db.Uuid
  userId         String   @db.Uuid
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  mediaId        String   @unique @db.Uuid
  media          Media    @relation(fields: [mediaId], references: [id], onDelete: Cascade)
  consentVersion String   @db.VarChar(20)
  expiresAt      DateTime @db.Timestamptz(3)
  createdAt      DateTime @default(now()) @db.Timestamptz(3)

  results TryOnResult[]

  @@index([userId, createdAt(sort: Desc)])
  @@index([expiresAt])
  @@map("try_on_photos")
}

enum TryOnStatus {
  PENDING
  READY
  FAILED
}

/// Una simulación: la foto de la persona con uno o varios productos. Privada y con fecha de
/// borrado; la firma (`cacheKey`) evita generar dos veces lo mismo.
model TryOnResult {
  id              String      @id @default(uuid(7)) @db.Uuid
  userId          String      @db.Uuid
  user            User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  photoId         String      @db.Uuid
  photo           TryOnPhoto  @relation(fields: [photoId], references: [id], onDelete: Cascade)
  /// Productos de la simulación en orden (la prenda principal primero).
  productIds      String[]    @db.Uuid
  /// SHA-256 de (foto, productos con sus fotos, versión del prompt, modelo).
  cacheKey        String      @unique @db.VarChar(64)
  status          TryOnStatus @default(PENDING)
  resultMediaId   String?     @unique @db.Uuid
  resultMedia     Media?      @relation("tryOnResultMedia", fields: [resultMediaId], references: [id], onDelete: SetNull)
  aiRequestId     String?     @unique @db.Uuid
  aiRequest       AIRequest?  @relation(fields: [aiRequestId], references: [id], onDelete: SetNull)
  funding         AIFunding   @default(PLATFORM)
  /// Tienda del producto principal (ADR-046): cuenta las pruebas de cortesía por tienda y le muestra
  /// cuántas personas se probaron sus productos. Nunca quiénes.
  sellerId        String?     @db.Uuid
  /// Vendedor que patrocinó la prueba (`SELLER_PAID`).
  sponsorSellerId String?     @db.Uuid
  /// Centavos cobrados a quien la financió (0 en las gratis).
  chargedCents    Int         @default(0)
  errorCode       String?     @db.VarChar(40)
  expiresAt       DateTime    @db.Timestamptz(3)
  createdAt       DateTime    @default(now()) @db.Timestamptz(3)

  @@index([userId, createdAt(sort: Desc)])
  @@index([expiresAt])
  @@index([sponsorSellerId, createdAt])
  @@index([sellerId, createdAt])
  @@map("try_on_results")
}

// ─────────────────────────── Estilista (ADR-043) ───────────────────────────

/// Un look armado por código con productos reales (P2, P4). Se guarda para volver a verlo,
/// probárselo y cambiar piezas; `items` conserva los ids y precios del momento.
model StyleLook {
  id               String   @id @default(uuid(7)) @db.Uuid
  userId           String?  @db.Uuid
  user             User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// Lo que la persona escribió, recortado y sin datos de contacto.
  needText         String   @db.VarChar(300)
  /// Necesidad interpretada (ocasión, estilo, presupuesto, colores, palabras clave), validada.
  need             Json
  /// [{ productId, slot, priceCents }] en orden de importancia.
  items            Json
  totalCents       Int
  currency         String   @default("MXN") @db.Char(3)
  title            String   @db.VarChar(80)
  explanation      String?  @db.VarChar(300)
  /// Quién escribió el título: `rules` (código), `ai` (modelo) o `simulated`.
  copySource       String   @db.VarChar(20)
  /// «Completa mi look»: el producto del que partió.
  anchorProductId  String?  @db.Uuid
  algorithmVersion String   @db.VarChar(20)
  createdAt        DateTime @default(now()) @db.Timestamptz(3)

  @@index([userId, createdAt(sort: Desc)])
  @@map("style_looks")
}
