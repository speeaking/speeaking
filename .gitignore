# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store

# llaves y certificados: nunca se versionan
*.pem
*.key
*.p12
*.pfx
*.jks
id_rsa*
id_ed25519*

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# plantilla de variables de entorno (sí se versiona)
!.env.example

# pruebas e2e (Playwright)
/test-results/
/playwright-report/
/blob-report/
/playwright/.cache/

# datos locales (clúster de PostgreSQL, archivos subidos)
/.data/

# cliente de Prisma generado (pnpm prisma generate)
/src/generated/

# estado local de Claude Code (permisos de esta máquina y worktrees de otras sesiones);
# .claude/launch.json sí se versiona
.claude/settings.local.json
.claude/worktrees/
