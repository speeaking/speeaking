# Copia este archivo a `.env.local` y ajusta los valores. Nunca subas secretos al repositorio.

# URL pública de la app: enlaces absolutos y vistas previas al compartir (Open Graph). En Vercel es
# obligatoria y con https (si falta, el build falla): al inicio https://<proyecto>.vercel.app.
APP_URL=http://localhost:3000

# Base de datos de desarrollo: se genera con `pnpm db:setup` (escribe DATABASE_URL en .env).
# DATABASE_URL="postgresql://usuario:contraseña@localhost:5434/speeaking?schema=public"

# Producción (Neon, docs/deploy.md): DATABASE_URL es la conexión CON pooler (host con `-pooler`) y
# con sslmode=require; DATABASE_URL_UNPOOLED es la directa (sin `-pooler`), que usa `pnpm vercel-build`
# para `prisma migrate deploy` (Prisma Migrate no funciona por el pooler). La integración de Neon en
# Vercel crea las dos. En desarrollo no hace falta la segunda.
# DATABASE_URL_UNPOOLED="postgresql://usuario:contraseña@ep-xxx.us-east-1.aws.neon.tech/neondb?sslmode=require"

# Secreto de sesiones (Better Auth): `pnpm db:setup` lo genera en .env. Mínimo 32 caracteres.
# BETTER_AUTH_SECRET="..."

# Almacenamiento de fotos (ADR-040). `local` = disco (desarrollo, en STORAGE_LOCAL_ROOT). `s3` = bucket
# PRIVADO compatible con S3: Cloudflare R2 en producción (las fotos siempre salen por /media, que
# autoriza cada petición; el bucket nunca se hace público).
STORAGE_DRIVER=local
# STORAGE_LOCAL_ROOT=.data/uploads
# Con NODE_ENV=production (fuera de localhost) y STORAGE_DRIVER=local, el arranque FALLA salvo que esto
# sea true: en una plataforma serverless (Vercel) el disco se pierde. Ponlo en true solo en un servidor
# con disco persistente y respaldado. En Vercel no vale ni con la bandera.
ALLOW_LOCAL_STORAGE=false
# Con STORAGE_DRIVER=s3 (obligatorias salvo la región). Endpoint = solo el origen (https, sin ruta);
# las llaves salen de un token de R2 con permiso «Object Read & Write» limitado a este bucket.
# S3_ENDPOINT=https://<id-de-cuenta>.r2.cloudflarestorage.com
# S3_BUCKET=speeaking-media
# S3_REGION=auto
# Secretos. Nunca en el repositorio.
# S3_ACCESS_KEY_ID="..."
# S3_SECRET_ACCESS_KEY="..."

# Proxies de confianza delante de Next para resolver la IP del cliente (límites de intentos y
# sesiones; ver src/server/client-ip.ts). 0 = Next expuesto directo (desarrollo): se ignora
# X-Forwarded-For y los límites por IP no aplican (quedan los de correo/usuario). N = la app solo es
# alcanzable a través de N proxies que AGREGAN a X-Forwarded-For (nginx con
# $proxy_add_x_forwarded_for = 1; Cloudflare -> nginx = 2; Vercel = 1). Rango 0-5. En Vercel el build
# falla con 0.
TRUSTED_PROXY_HOPS=0

# Pagos. Hoy solo existe `mock`: la pasarela simulada, que NO cobra (/checkout/pago/...).
PAYMENT_PROVIDER=mock
# Con NODE_ENV=production (`pnpm build`/`pnpm start`, despliegues) y PAYMENT_PROVIDER=mock, el
# arranque FALLA salvo que esto sea true: nadie paga de verdad y los vendedores verían pedidos
# "pagados" sin cobro. Ponlo en true solo para un build local o un piloto cerrado, como decisión
# explícita. En desarrollo y pruebas no hace falta. Las RECARGAS DE SALDO simuladas solo existen en
# desarrollo y en un build en localhost: en un sitio público el saldo pagaría IA real (ADR-071).
ALLOW_SIMULATED_PAYMENTS=false

# IA. `mock` (por omisión) = IA simulada, sin costo. `openai_compatible` = modelo abierto pagado por
# uso en un servidor EXTERNO con API compatible con OpenAI (p. ej. OpenRouter, DeepInfra, Together o
# un servidor con GPU rentado que corra vLLM); nada se instala en tu PC (ADR-033 #6 y #9). Con
# `openai_compatible`, AI_BASE_URL, AI_API_KEY y AI_DEFAULT_MODEL son obligatorias; la URL debe ser
# https (salvo 127.0.0.1/localhost) y sin credenciales. El modelo necesita precio en
# src/modules/ai/cost.ts: sin precio no se llama.
AI_PROVIDER=mock
# AI_BASE_URL=https://openrouter.ai/api/v1
# Secreto, mínimo 16 caracteres. Nunca en el repositorio.
# AI_API_KEY="..."
# AI_DEFAULT_MODEL=qwen/qwen3.5-9b
# Modelo que genera imágenes desde el chat para «Pruébatelo» (ADR-043), en el mismo servidor y con
# la misma llave. Sin él, las imágenes usan el simulador (en producción quedan «no disponibles»).
# Precio por imagen con fecha en src/modules/ai/cost.ts; un modelo sin precio no se llama.
# Con OpenRouter el modelo necesita un endpoint con cero retención de datos (se exige `zdr`): los
# «-preview» de Google no lo tienen y responden 404 «data policy»; los ids finales sí.
# AI_IMAGE_MODEL=google/gemini-3.1-flash-image
# Modelo que VE fotos para «Buscar con una foto» (ADR-061), en el mismo servidor y con la misma
# llave: describe la ropa y los objetos de la foto (nunca a las personas) y el código busca en el
# catálogo. ≈ US$0.0004 por foto. Sin él, con openai_compatible la búsqueda por foto no está
# disponible (el modelo de texto no ve imágenes); con mock usa el simulador. Precio en cost.ts.
# No uses google/gemini-2.5-flash-lite: OpenRouter lo retira el 2026-10-20 (ADR-071).
# AI_VISION_MODEL=google/gemini-3.5-flash-lite

# Subir videos cortos (ADR-062). Sin definir: sí con STORAGE_DRIVER=local; con el bucket (s3), solo
# con true DESPUÉS de poner la regla de CORS del bucket (docs/deploy.md, paso 4 bis): el navegador
# sube el video directo a R2 y sin esa regla la subida falla.
# VIDEO_UPLOADS=true
# Con NODE_ENV=production (`pnpm build`/`pnpm start`, despliegues) y AI_PROVIDER=mock, el arranque
# FALLA salvo que esto sea true: la IA sería simulada y los vendedores recibirían en «Sube y vende» y
# en el kit de anuncios textos de PLANTILLA, no de un modelo. Ponlo en true solo para un build local
# o un piloto cerrado, como decisión explícita (espejo de ALLOW_SIMULATED_PAYMENTS). En desarrollo y
# pruebas no hace falta; con AI_PROVIDER=openai_compatible no tiene efecto.
ALLOW_SIMULATED_AI=false

# Liga externa para apoyar el proyecto (ADR-048): un link de pago de Mercado Pago, PayPal.me,
# Ko-fi… Solo https. Con ella, /apoya muestra el botón y la columna derecha la tarjeta «Apoya a
# speeaking». Sin ella, la página solo explica los costos. El dinero nunca pasa por la plataforma.
# SUPPORT_URL="https://link.mercadopago.com.mx/..."

# Entrar con Google (ADR-049). En Google Cloud → APIs y servicios → Credenciales → «ID de cliente
# de OAuth» (aplicación web): orígenes autorizados = APP_URL; URI de redirección autorizada =
# <APP_URL>/api/auth/callback/google. Las dos variables o ninguna; sin ellas no hay botón.
# GOOGLE_CLIENT_ID="...apps.googleusercontent.com"
# GOOGLE_CLIENT_SECRET="..."

# Recuperar contraseña: crea una API key de Resend y verifica tu dominio con sus registros DNS.
# EMAIL_FROM debe pertenecer a ese dominio. Las dos variables o ninguna; nunca NEXT_PUBLIC_.
# Sin ellas, el formulario explica que el envío aún no está disponible.
# RESEND_API_KEY="re_..."
# EMAIL_FROM="cuentas@tu-dominio.com"

# Secreto de las tareas programadas (/api/cron/*, cabecera `Authorization: Bearer <secreto>`).
# Obligatorio en producción (salvo un build local en localhost), mínimo 32 caracteres. Sin él, las
# rutas de cron rechazan toda petición. Genera uno con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# CRON_SECRET="..."

# SEO público; false suspende la indexación. Local y previews no se indexan.
ALLOW_INDEXING=true
