# Copia este archivo a `.env.local` y ajusta los valores. Nunca subas secretos al repositorio.

# URL pública de la app: enlaces absolutos y vistas previas al compartir (Open Graph).
APP_URL=http://localhost:3000

# Base de datos de desarrollo: se genera con `pnpm db:setup` (escribe DATABASE_URL en .env).
# DATABASE_URL="postgresql://usuario:contraseña@localhost:5434/vendeia?schema=public"

# Secreto de sesiones (Better Auth): `pnpm db:setup` lo genera en .env. Mínimo 32 caracteres.
# BETTER_AUTH_SECRET="..."

# Proxies de confianza delante de Next para resolver la IP del cliente (límites de intentos y
# sesiones; ver src/server/client-ip.ts). 0 = Next expuesto directo (desarrollo): se ignora
# X-Forwarded-For y los límites por IP no aplican (quedan los de correo/usuario). N = la app solo es
# alcanzable a través de N proxies que AGREGAN a X-Forwarded-For (nginx con
# $proxy_add_x_forwarded_for = 1; Cloudflare -> nginx = 2; Vercel = 1). Rango 0-5.
TRUSTED_PROXY_HOPS=0

# Pagos. Hoy solo existe `mock`: la pasarela simulada, que NO cobra (/checkout/pago/...).
PAYMENT_PROVIDER=mock
# Con NODE_ENV=production (`pnpm build`/`pnpm start`, despliegues) y PAYMENT_PROVIDER=mock, el
# arranque FALLA salvo que esto sea true: nadie paga de verdad y los vendedores verían pedidos
# "pagados" sin cobro. Ponlo en true solo para un build local o un piloto cerrado, como decisión
# explícita. En desarrollo y pruebas no hace falta.
ALLOW_SIMULATED_PAYMENTS=false

# IA. `mock` (por omisión) = IA simulada, sin costo. `openai_compatible` = modelo abierto pagado por
# uso en un servidor EXTERNO con API compatible con OpenAI (p. ej. OpenRouter, DeepInfra, Together o
# un servidor con GPU rentado que corra vLLM); nada se instala en tu PC (ADR-033 #6 y #9). Con
# `openai_compatible`, AI_BASE_URL, AI_API_KEY y AI_DEFAULT_MODEL son obligatorias; la URL debe ser
# https (salvo 127.0.0.1/localhost) y sin credenciales. El modelo necesita precio en
# src/modules/ai/cost.ts: sin precio no se llama.
AI_PROVIDER=mock
# AI_BASE_URL=https://openrouter.ai/api/v1
# Secreto, mínimo 16 caracteres. Nunca en el repositorio.
# AI_API_KEY="..."
# AI_DEFAULT_MODEL=qwen/qwen3.5-9b
# Con NODE_ENV=production (`pnpm build`/`pnpm start`, despliegues) y AI_PROVIDER=mock, el arranque
# FALLA salvo que esto sea true: la IA sería simulada y los vendedores recibirían en «Vende con IA» y
# en el kit de anuncios textos de PLANTILLA, no de un modelo. Ponlo en true solo para un build local
# o un piloto cerrado, como decisión explícita (espejo de ALLOW_SIMULATED_PAYMENTS). En desarrollo y
# pruebas no hace falta; con AI_PROVIDER=openai_compatible no tiene efecto.
ALLOW_SIMULATED_AI=false

# Secreto de las tareas programadas (/api/cron/*, cabecera `Authorization: Bearer <secreto>`).
# Obligatorio en producción (salvo un build local en localhost), mínimo 32 caracteres. Sin él, las
# rutas de cron rechazan toda petición. Genera uno con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# CRON_SECRET="..."
